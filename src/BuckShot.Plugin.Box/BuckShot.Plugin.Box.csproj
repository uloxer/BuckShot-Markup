<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <None Include="Languages\buckshot*.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Loaded with EmbeddedResources.GetImage(typeof(BoxPlugin), "Box") -->
    <EmbeddedResource Include="Images\Box.png" LogicalName="BuckShot.Plugin.Box.BoxPlugin.Box" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BuckShot.Base\BuckShot.Base.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>
</Project>