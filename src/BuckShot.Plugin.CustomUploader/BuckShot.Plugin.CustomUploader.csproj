<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <PropertyGroup>
    <RootNamespace>BuckShot.Plugin.CustomUploader</RootNamespace>
    <AssemblyName>BuckShot.Plugin.CustomUploader</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <None Include="Languages\buckshot*.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <!-- Loaded with EmbeddedResources.GetImage(typeof(CustomUploaderPlugin), "Upload"), when a service has no icon -->
    <EmbeddedResource Include="Images\Upload.png" LogicalName="BuckShot.Plugin.CustomUploader.CustomUploaderPlugin.Upload" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BuckShot.Base\BuckShot.Base.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>
</Project>
