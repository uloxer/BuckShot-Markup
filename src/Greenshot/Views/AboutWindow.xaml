<Window x:Class="Greenshot.Views.AboutWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
 Title="{Binding WindowTitleText}" Icon="{Binding WindowIconSource}" Width="590" SizeToContent="Height"
 ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="{Binding WindowBackgroundBrush}">
 <StackPanel>
  <wpf:ThemedTitleBar ShowThemeToggle="True"/>
  <StackPanel Margin="24,16,24,24">
   <Image Source="/Greenshot;component/Branding/blueprint-panel.png" Height="180" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,18"/>
   <TextBlock Text="{Binding AppVersionTitle}" FontSize="24" FontWeight="Bold" Foreground="{Binding TextPrimaryBrush}"/>
   <TextBlock Text="Screenshot capture and engineering markup" Margin="0,8,0,16" Foreground="{Binding TextSecondaryBrush}"/>
   <TextBlock Text="Based on Greenshot. Copyright © 2007–2026 Thomas Braun, Jens Klingen, Robin Krom and contributors. BuckShot Markup changes by its contributors."
    TextWrapping="Wrap" Foreground="{Binding TextPrimaryBrush}" Margin="0,0,0,12"/>
   <TextBlock Text="Distributed under the GNU General Public License, version 3 or later. No warranty." TextWrapping="Wrap" Foreground="{Binding TextSecondaryBrush}"/>
   <TextBlock Margin="0,8,0,16"><Hyperlink NavigateUri="https://www.gnu.org/licenses/gpl-3.0.html" RequestNavigate="OnHyperlinkRequestNavigate">Read the GNU GPL</Hyperlink></TextBlock>
   <TextBlock Text="Upstream icon credits: Yusuke Kamiyamane and the Greenshot contributors."
    TextWrapping="Wrap" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,18"/>
   <Button Content="Close" IsDefault="True" IsCancel="True" Click="OnCloseClicked" HorizontalAlignment="Right" Padding="20,6"/>
  </StackPanel>
 </StackPanel>
</Window>
