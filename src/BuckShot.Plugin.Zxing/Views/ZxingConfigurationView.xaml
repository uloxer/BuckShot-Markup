<UserControl x:Class="BuckShot.Plugin.Zxing.Views.ZxingConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:BuckShot.Base.Wpf;assembly=BuckShot.Base">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BuckShot.Base;component/Wpf/Styles/CheckBoxStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Margin="8">
        <CheckBox IsChecked="{Binding ScanOnCapture}"
                  Content="{wpf:Text Core.ZxingScanScreenCaptures}"/>
    </StackPanel>
</UserControl>
